{
	"welcomer": {
		"commands": {
			"dm-text": {
				"welcomer": {
					"dm": {
						"text": {
							"set": "Welcome DM text set to:\n> {text}"
						}
					}
				}
			},
			"in-background": {
				"welcomer": {
					"in": {
						"background": {
							"invalid": {
								"url": "Background URL must start with `http`."
							},
							"set": "Welcome background set to:\n{url}"
						}
					}
				}
			},
			"in-channel": {
				"welcomer": {
					"in": {
						"channel": {
							"set": "Welcome channel set to <#{channelId}>"
						}
					}
				}
			},
			"in-style": {
				"welcomer": {
					"in": {
						"style": {
							"set": "Welcome message style set to **{styleLabel}**."
						}
					}
				}
			},
			"in-text": {
				"welcomer": {
					"in": {
						"text": {
							"set": "Welcome message text set to:\n> {text}"
						}
					}
				}
			},
			"out-background": {
				"welcomer": {
					"out": {
						"background": {
							"invalid": {
								"url": "Background URL must start with `http`."
							},
							"set": "Farewell background set to:\n{url}"
						}
					}
				}
			},
			"out-channel": {
				"welcomer": {
					"out": {
						"channel": {
							"set": "Farewell channel set to <#{channelId}>"
						}
					}
				}
			},
			"out-style": {
				"welcomer": {
					"out": {
						"style": {
							"set": "Farewell message style set to **{styleLabel}**."
						}
					}
				}
			},
			"out-text": {
				"welcomer": {
					"out": {
						"text": {
							"set": "Farewell message text set to:\n> {text}"
						}
					}
				}
			},
			"role": {
				"welcomer": {
					"set": "Auto-role on join set to <@&{roleId}>"
				}
			},
			"test": {
				"welcomer": {
					"success": "Successfully emitted the **{type}** event for testing. Check the configured channel!"
				}
			}
		},
		"shared": {
			"welcomer": {
				"style": {
					"label": {
						"components": {
							"v2": "Components V2 card"
						},
						"plain": {
							"text": "Plain text only"
						}
					}
				}
			}
		}
	}
}
