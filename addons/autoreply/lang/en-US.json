{
	"autoreply": {
		"commands": {
			"add": {
				"error": {
					"no_content": "You must provide either a response text or an image."
				},
				"success": {
					"plain": "**Auto-reply Added!**\nTrigger: `{trigger}`\n*Using Advanced Container Style*"
				}
			},
			"remove": {
				"error": {
					"not_found": "Auto-reply not found."
				},
				"success": {
					"plain": "**Auto-reply Removed!**\nTrigger: `{trigger}`"
				}
			}
		},
		"shared": {
			"add": {
				"error": {
					"exists": "An auto-reply with this trigger already exists."
				}
			}
		},
		"helpers": {
			"ui": {
				"list": {
					"empty": "No auto-replies set for this server.",
					"container_tag": "*(Container)*",
					"entry": "• **{trigger}** {container}\n",
					"title": "## Auto-Replies List ({page}/{totalPages})",
					"footer": "Page {page} of {totalPages}"
				}
			}
		}
	}
}
