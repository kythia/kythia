						"age": "Account age: **{days} days**"
					},
					"type": {
						"fake": "fake",
						"real": "real"
					},
					"joined": {
						"by": "{user} ({username}) joined using an invite from {inviter} ({inviterTag})\nType: **{inviteType}**",
						"vanity": "{user} ({username}) joined using a **vanity invite** (`{code}`)",
						"oauth": "{user} ({username}) joined using **OAuth (bot invite)**",
						"unknown": "{user} ({username}) joined (unknown invite source)"
					},
					"code": "Invite code: `{code}`"
				}
			},
			"guildMemberRemove": {
				"tracker": {
					"title": "Member Left",
					"left": "{user} ({username}) left. Invited by {inviter}",
					"unknown": "{user} ({username}) left. (Inviter unknown or history missing)"
				}
			}
		},
		"helpers": {
			"index": {
				"invite": {
					"command": {
						"title": "## Invites"
					}
				}
			},
			"leaderboard": {
				"invite": {
					"command": {
						"empty": "No data yet.",
						"entry": "### {medal} **{username}**\n> Total Invites: **{invites}**",
