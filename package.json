		"@napi-rs/canvas": "^0.1.66",
		"@sentry/node": "^10.10.0",
		"archiver": "^7.0.1",
		"async-mutex": "^0.5.0",
		"axios": "^1.12.2",
		"discord.js": "^14.25.1",
		"figlet": "^1.9.3",
		"hono": "^4.10.7",
		"ioredis": "^5.4.1",
		"javascript-obfuscator": "^4.1.1",
		"kythia-arts": "^26.0.0-rc.2",
		"kythia-core": "file:.yalc/kythia-core",
		"luxon": "^3.7.2",
		"marked": "^4.3.0",
		"mathjs": "^15.1.0",
		"module-alias": "^2.2.3",
