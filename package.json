{
	"name": "kythia",
	"version": "26.0.0-rc.1",
	"description": "Kythia Hye-Jin! Your sweet, cute, and beautiful companion! ",
	"main": "index.js",
	"author": {
		"name": "kenndeclouv",
		"email": "kenndeclouv@gmail.com"
	},
	"license": "SEE LICENSE IN LICENSE",
	"scripts": {
		"start": "node index.js",
		"start:bun": "bun index.js",
		"shard": "node sharding.js",
		"shard:bun": "bun sharding.js",
		"dev": "bun index.js --dev",
		"setup": "node setup.js",
		"setup:bun": "bun setup.js",
		"format": "biome format --write .",
		"fix": "biome check --write .",
		"fix:unsafe": "biome check --write --unsafe .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,json,md}": [
			"bun format"
		]
	},
	"dependencies": {
